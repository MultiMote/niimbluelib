{
  "name": "@mmote/niimbluelib",
  "version": "0.47.0-node",
  "description": "Library for the communication with NIIMBOT printers",
  "keywords": [
    "reverse-engineering",
    "thermal-printer",
    "label-printer",
    "niimbot",
    "niimbot-d110",
    "niimbot-b1",
    "niimbot-b21",
    "bluetooth",
    "serial",
    "capacitor"
  ],
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MultiMote/niimbluelib.git"
  },
  "author": "MultiMote",
  "license": "MIT",
  "private": false,
  "scripts": {
    "clean-build": "npm run clean && npm run build",
    "build": "tsc --build tsconfig.build.json",
    "watch": "tsc --watch",
    "build:bundle": "node bundle.mjs",
    "parse-wireshark-dump": "npm run build && node tools/parse-wireshark-dump.mjs",
    "parse-text-dump": "npm run build && node tools/parse-text-dump.mjs",
    "clean": "node clean-dist.mjs",
    "gen-printer-models": "node tools/gen-printer-models.js > src/printer_models.ts",
    "test": "npm run clean && tsc --build && node --test dist/cjs/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.7",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/web-bluetooth": "^0.0.21",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor/core": "^8.3.0",
    "@stoprocent/noble": "^2.5.5",
    "async-mutex": "^0.5.0",
    "crc-32": "^1.2.2",
    "eventemitter3": "^5.0.4",
    "serialport": "^13.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "usb": true,
    "@serialport/bindings-cpp": true,
    "@stoprocent/noble": true,
    "@stoprocent/bluetooth-hci-socket": true
  }
}
